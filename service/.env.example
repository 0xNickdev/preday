# Port the HTTP server listens on.
PORT=8787

# Main Preday contract. Workers are paid at <handle>.<PREDAY_CONTRACT>.
PREDAY_CONTRACT=preday.near

# NEAR JSON-RPC endpoint used to send sweep() transactions.
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com

# Account that pays gas for sweep(). It never holds user funds.
KEEPER_ACCOUNT_ID=keeper.preday.near
KEEPER_PRIVATE_KEY=ed25519:...

# Optional 1Click partner key, sent in the X-API-Key header.
ONECLICK_API_KEY=

# The only browser origin allowed to call this service.
ALLOWED_ORIGIN=http://localhost:5173
